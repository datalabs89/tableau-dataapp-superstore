# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# The .twbx is a ZIP and must never be line-ending mangled.
*.twbx binary
*.twb  binary
*.xlsx binary
*.png  binary

# Keep these exactly as written so the build stays byte-reproducible.
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
